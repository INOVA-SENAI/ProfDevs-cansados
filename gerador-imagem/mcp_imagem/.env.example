# Credenciais (escolha uma):
#  - rode `aws login` uma vez (a sessão vale 12 h e o boto3 renova sozinho), ou
#  - cole uma chave de API da Bedrock abaixo. Nunca faça commit do .env.
AWS_BEARER_TOKEN_BEDROCK=
# Região da chamada. Os modelos Stability usados estão em us-east-1, us-east-2 e us-west-2.
AWS_REGION=us-east-1
